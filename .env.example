# ==============================================================================
# SmartAttend Environment Variables Configuration Template
# ==============================================================================
# Copy this file to 'server/.env' for backend development:
#   cp .env.example server/.env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real credentials, production secrets, or private keys to Git.
# - The server will safely refuse to start in production if JWT_SECRET is unset.
# ==============================================================================

# Server Network Configuration
PORT=10000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Authentication (Required)
# ------------------------------------------------------------------------------
# Obtain from Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co
# High-privilege secret token required for backend writes past Row Level Security (RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 2. Cryptographic JWT Authentication Secret (Required)
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_character_cryptographically_secure_jwt_secret_here

# ------------------------------------------------------------------------------
# 3. Google Gemini Multimodal AI (Required for OCR Leave & Chat Assistant)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Email Notification Engines (Google Apps Script or SMTP)
# ------------------------------------------------------------------------------
# Engine A: Google Apps Script Web App Relay (Recommended for cloud hosting like Render/AWS)
EMAIL_SCRIPT_URL=https://script.google.com/macros/s/your_gas_webapp_id/exec

# Optional diagnostic test recipient
DEBUG_TEST_EMAIL=admin@smartattend.edu

# Engine B: Direct SMTP Transport (Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_institution_email@gmail.com
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_16_char_app_password
